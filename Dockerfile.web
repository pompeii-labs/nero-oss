# Nero Web — the SvelteKit static build, served by nginx. nginx also reverse-
# proxies /v1, /api, /webhook to the API container, so the browser sees one
# origin (no CORS, no runtime API-URL config) and deep links fall back to the SPA.
FROM oven/bun:1 AS builder
WORKDIR /app/web
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile
COPY web/ ./
# Drop the dev .env (it hardcodes PUBLIC_NERO_SERVER_URL=localhost). The shipped
# build must use relative URLs so the browser talks to whatever host served it and
# nginx proxies /v1 to the api. Works from localhost, a LAN IP, or a domain.
RUN rm -f .env .env.local .env.development && bun run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nero-locations.conf /etc/nginx/nero-locations.conf
# tls.d is empty by default; `nero start` mounts a :443 server + cert here for HTTPS.
RUN mkdir -p /etc/nginx/tls.d /etc/nginx/certs
COPY --from=builder /app/web/build /usr/share/nginx/html
EXPOSE 80 443
