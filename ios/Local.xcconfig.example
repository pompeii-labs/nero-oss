// Copy this to `Local.xcconfig` (gitignored) and set your Apple Developer Team ID.
// This survives `xcodegen generate`, so your signing never gets wiped.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic

// Optional: your Nero server host (no scheme, e.g. your-box.tailnet.ts.net or a LAN IP).
// Set it to skip onboarding on your own builds; leave blank to onboard in-app.
NERO_DEFAULT_SERVER_HOST =
