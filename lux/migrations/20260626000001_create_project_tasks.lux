TCREATE project_tasks id UUID PRIMARY KEY DEFAULT uuid(), project_id TEXT, idx INT DEFAULT 0, title TEXT, description TEXT, depends_on JSON, tools JSON, status TEXT DEFAULT 'pending', streaming_text TEXT, activities JSON, result TEXT, input_tokens INT DEFAULT 0, output_tokens INT DEFAULT 0, cost_usd FLOAT DEFAULT 0, job_id TEXT, created_at INT DEFAULT now(), updated_at INT DEFAULT now()
